{{ define "pages/packages/global" }}
<section class="page-section">
  <header class="page-header">
    <h1>Packages</h1>
    <p class="muted">All packages across every tenant you can read. Use <a href="/console/tenants">Tenants</a> to manage tenant-specific settings, or click a package to view its versions.</p>
  </header>

  <form method="get" style="margin-bottom:12px">
    <label for="provenance" style="margin-right:6px">Filter by provenance:</label>
    <select id="provenance" name="provenance" onchange="this.form.submit()">
      <option value=""             {{ if eq .Body.ProvenanceFilter ""             }}selected{{ end }}>All</option>
      <option value="uploaded"     {{ if eq .Body.ProvenanceFilter "uploaded"     }}selected{{ end }}>uploaded</option>
      <option value="pull_through" {{ if eq .Body.ProvenanceFilter "pull_through" }}selected{{ end }}>mirrored from upstream</option>
    </select>
    <noscript><button type="submit" class="btn btn-ghost btn-sm">Apply</button></noscript>
  </form>

  {{ if .Body.Rows }}
  <table class="table">
    <thead>
      <tr>
        <th>Tenant</th>
        <th>Format</th>
        <th>Package</th>
        <th>Provenance</th>
        <th>Versions</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{ range .Body.Rows }}
      <tr>
        <td><a href="/console/tenants/{{ .TenantName }}">{{ .TenantName }}</a></td>
        <td>{{ .Type }}</td>
        <td><a href="/console/tenants/{{ .TenantName }}/packages/{{ .Type }}/{{ .Name }}">{{ .Name }}</a></td>
        <td><span class="muted">{{ default "-" .Provenance }}</span></td>
        <td>{{ .Versions }}</td>
        <td><a href="/console/tenants/{{ .TenantName }}/packages/{{ .Type }}/{{ .Name }}">View</a></td>
      </tr>
      {{ end }}
    </tbody>
  </table>
  {{ else }}
  {{ template "ui/alert" (dict "severity" "info" "title" "No packages"
        "body" "No tenant you can read has any packages yet. Upload one via the registry API or wait for a pull-through fetch to land.") }}
  {{ end }}
</section>
{{ end }}
