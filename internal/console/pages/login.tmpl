{{ define "pages/login" }}
<form method="post" action="/console/login" class="auth-form">
  {{ .Base.CSRFField }}
  {{ if index .Body.Errors "form" }}
    <div class="alert alert-danger" role="alert">
      <div class="alert-body">{{ index .Body.Errors "form" }}</div>
    </div>
  {{ end }}
  <div class="field">
    <label for="username" class="field-label">Username</label>
    <input id="username" name="username" type="text" autocomplete="username"
           class="field-input" value="{{ .Body.Username }}" autofocus required>
  </div>
  <div class="field">
    <label for="password" class="field-label">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password"
           class="field-input" required>
  </div>
  <button type="submit" class="btn btn-primary" style="width:100%">Sign in</button>
  <p class="muted field-help" style="margin-top:14px">
    First time? Sign in with your personal access token to set a password.
  </p>
</form>
{{ end }}
