{{ define "pages/setpassword" }}
<form method="post" action="/console/set-password" class="auth-form">
  {{ .Base.CSRFField }}
  {{ if index .Body.Errors "form" }}
    <div class="alert alert-danger" role="alert">
      <div class="alert-body">{{ index .Body.Errors "form" }}</div>
    </div>
  {{ end }}
  <p class="muted" style="margin-bottom:18px">
    Set a console password. Verify with the personal access token you
    were issued at account creation.
  </p>
  <div class="field">
    <label for="username" class="field-label">Username</label>
    <input id="username" name="username" type="text" autocomplete="username"
           class="field-input" value="{{ .Body.Username }}" required>
  </div>
  <div class="field">
    <label for="token" class="field-label">Personal access token (one-time)</label>
    <input id="token" name="token" type="password" autocomplete="off"
           class="field-input" placeholder="pkm_..." required>
    <p class="field-help">Used to verify the account. Not stored.</p>
  </div>
  <div class="field">
    <label for="new_password" class="field-label">New password</label>
    <input id="new_password" name="new_password" type="password" autocomplete="new-password"
           class="field-input" minlength="12" required>
    {{ with index .Body.Errors "new_password" }}<p class="field-error">{{ . }}</p>{{ end }}
    <p class="field-help">12 characters minimum.</p>
  </div>
  <div class="field">
    <label for="confirm_password" class="field-label">Confirm new password</label>
    <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password"
           class="field-input" minlength="12" required>
    {{ with index .Body.Errors "confirm_password" }}<p class="field-error">{{ . }}</p>{{ end }}
  </div>
  <button type="submit" class="btn btn-primary" style="width:100%">Set password & sign in</button>
  <p class="muted field-help" style="margin-top:14px">
    <a href="/console/login">Back to sign in</a>
  </p>
</form>
{{ end }}
