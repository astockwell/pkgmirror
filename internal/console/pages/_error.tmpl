{{ define "pages/_error" }}
<section class="page-section error-page">
  <header class="page-header">
    <h1>Something went wrong</h1>
    <p>We couldn't <strong>{{ .Verb }}</strong>. The error has been logged.</p>
    {{ if .RequestID }}
    <p class="muted">Request ID: <code>{{ .RequestID }}</code></p>
    {{ end }}
  </header>
  <p><a href="javascript:history.back()">Go back</a></p>
</section>
{{ end }}
